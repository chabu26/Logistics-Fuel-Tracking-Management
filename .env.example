# Copy to .env and adjust. Every value here has a development default; in production all are required.
DATABASE_URL=postgres://fleetfuel:fleetfuel@localhost:5432/fleetfuel
PORT=4000

# Secret used to sign sign-in tokens. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=dev-only-secret-change-me
TOKEN_TTL_HOURS=12

# Shared key trackers (or the simulator) send in the x-ingest-key header
INGEST_KEY=dev-ingest-key

# Which web origin may call the API from a browser
CORS_ORIGIN=*
